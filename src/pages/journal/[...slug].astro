---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const journalEntries = await getCollection('journal');
  return journalEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;
---

<Layout>
  <main class="journal-entry-container">
    <a href="/journal" class="back-link">← Back to Journal</a>
    
    <article class="journal-entry">
      <header class="journal-entry-header">
        <h1 class="journal-entry-title">{data.title}</h1>
        <div class="journal-entry-meta">
          <time class="journal-entry-date" datetime={data.date.toISOString()}>
            {data.date.toLocaleDateString('en-US', { 
              weekday: 'long',
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
          {data.mood && (
            <div class="journal-entry-mood">
              <span class="mood-label">mood:</span>
              <span class="mood-value">{data.mood}</span>
            </div>
          )}
        </div>
      </header>
      
      <div class="journal-entry-content prose prose-invert prose-lg">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .journal-entry-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem;
    min-height: 100vh;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: rgba(0, 255, 255, 0.9);
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
  }

  .journal-entry {
    width: 100%;
  }

  .journal-entry-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .journal-entry-title {
    font-family: 'Inter', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .journal-entry-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .journal-entry-date {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .journal-entry-mood {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .mood-label {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    color: rgba(255, 255, 255, 0.5);
    text-transform: lowercase;
  }

  .mood-value {
    font-family: 'Inter', sans-serif;
    color: rgba(255, 255, 255, 0.8);
    font-style: italic;
  }

  .journal-entry-content {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.8;
  }

  /* Tailwind Typography overrides for dark mode */
  .journal-entry-content :global(h1),
  .journal-entry-content :global(h2),
  .journal-entry-content :global(h3),
  .journal-entry-content :global(h4) {
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .journal-entry-content :global(h1) {
    font-size: 2.25rem;
  }

  .journal-entry-content :global(h2) {
    font-size: 1.875rem;
  }

  .journal-entry-content :global(h3) {
    font-size: 1.5rem;
  }

  .journal-entry-content :global(p) {
    margin-bottom: 1.5rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .journal-entry-content :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .journal-entry-content :global(a) {
    color: rgba(0, 255, 255, 0.9);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }

  .journal-entry-content :global(a:hover) {
    color: #00ffff;
    border-bottom-color: rgba(0, 255, 255, 0.5);
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
  }

  .journal-entry-content :global(code) {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    color: rgba(0, 255, 255, 0.9);
  }

  .journal-entry-content :global(pre) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .journal-entry-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: rgba(255, 255, 255, 0.9);
  }

  .journal-entry-content :global(ul),
  .journal-entry-content :global(ol) {
    margin: 1.5rem 0;
    padding-left: 2rem;
  }

  .journal-entry-content :global(li) {
    margin: 0.5rem 0;
    color: rgba(255, 255, 255, 0.8);
  }

  .journal-entry-content :global(blockquote) {
    border-left: 3px solid rgba(0, 255, 255, 0.5);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }

  .journal-entry-content :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 2rem 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .journal-entry-container {
      padding: 2rem 1rem;
    }

    .journal-entry-title {
      font-size: 2rem;
    }

    .journal-entry-content :global(h1) {
      font-size: 1.75rem;
    }

    .journal-entry-content :global(h2) {
      font-size: 1.5rem;
    }

    .journal-entry-content :global(h3) {
      font-size: 1.25rem;
    }
  }
</style>
